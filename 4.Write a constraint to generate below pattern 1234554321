class packet;
  rand bit[8:0] a[10];
  
  constraint x{  foreach(a[i])
    if(i<5)
      a[i] ==i+1;
               else
                 a[i] == 10-i;
    
              }
  
  function void post_randomize();
    $display("a=%0p", a);
  endfunction
  
endclass

