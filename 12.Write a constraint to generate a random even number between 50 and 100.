//Write a constraint to generate a random even number between 50 and 100.


class packet;
  rand int a[];
  constraint x{ foreach(a[i]) a[i] inside {[50:100]};}
  constraint j{ a.size==51;}
  

  constraint aax{foreach(a[i])
    a[i]%2==0;
              } // for even
  function void post_randomize();
               $display("a=%0d", a);
  endfunction
  
endclass

module tab;
  packet pac=new();
  initial begin
      assert(pac.randomize());
  end
endmodule 
