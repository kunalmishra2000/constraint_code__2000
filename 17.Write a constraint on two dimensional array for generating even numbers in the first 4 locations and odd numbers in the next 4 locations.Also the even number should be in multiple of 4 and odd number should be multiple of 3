/* Write a constraint on two dimensional array for generating even
numbers in the first 4 locations and odd numbers in the next 4
locations.Also the even number should be in multiple of 4 and odd number
should be multiple of 3.*/

class packet;

  rand int a[2][4];
  
  constraint aaaa{ foreach(a[i]) foreach(a[j]) a[i][j] inside {[1:1000]};}
  
  constraint x{ foreach(a[i])
    foreach(a[j])
    if(i==0)
      a[i][j]%4==0;
               else 
                 
                 a[i][j]%3==0;
              }
  
  
  function void post_randomize();
   
    $display("a=%0p",a);
  endfunction
  
endclass

module tab;
  packet pac=new();
  initial begin
      assert(pac.randomize());
end
  
endmodule 
