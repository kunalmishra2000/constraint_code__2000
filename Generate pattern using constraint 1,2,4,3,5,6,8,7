
////1. Generate pattern using constraint 1,2,4,3,5,6,8,7


class packet;
  
  rand int a[8];
  
  constraint x{ foreach(a[i]){
    
    if(i==3 || i==7)
      a[i]==i;
    else if(i <2 ||i==4 ||i==5)
      a[i]==i+1;
    else
      a[i]== i+2;
  }
              }
    
    
    
      function void post_randomize();
    $display("a=%0p", a);
    endfunction 
    endclass
    
    module tab;
      packet pac[2];
      initial begin
        foreach(pac[i])begin
        pac[i]=new();
        pac[i].randomize();
        end
      end
    endmodule 
